{
  "manifest_version": 3,
  "name": "Drein Grocery Coles Cart Helper",
  "version": "0.2.0",
  "description": "Guides mapped grocery items through Coles one at a time. It never adds items or checks out.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://drein.net/*", "https://www.coles.com.au/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://drein.net/groceries*"],
      "js": ["grocery-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.coles.com.au/*"],
      "js": ["coles-runner.js"],
      "run_at": "document_idle"
    }
  ]
}
