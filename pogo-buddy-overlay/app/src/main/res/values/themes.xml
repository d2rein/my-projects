<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.BuddyOverlay" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor" tools:targetApi="l">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="colorPrimary">@color/accent</item>
        <item name="colorSecondary">@color/accentWarm</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:textColor">@color/textPrimary</item>
    </style>

    <style name="Theme.BuddyOverlay.Transparent" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
